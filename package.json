{
  "name": "takt",
  "version": "0.1.0",
  "description": "Takt TypeScript software factory runtime for Codex-powered implementation workers.",
  "type": "module",
  "bin": {
    "takt": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:factory": "vitest run src/harness/toyWebappFactory.test.ts",
    "test:fixtures": "vitest run src/harness/toyWebappFactory.test.ts src/harness/runnableFixtures.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "toy:build": "tsc -p examples/toy-webapp/tsconfig.json",
    "toy:go:test": "mkdir -p .takt/go-build-cache && cd examples/toy-go-service && GOCACHE=\"$(pwd)/../../.takt/go-build-cache\" go test ./...",
    "toy:cli:test": "cd examples/toy-node-cli && node --test",
    "toy:typecheck": "tsc -p examples/toy-webapp/tsconfig.json --noEmit",
    "verify": "pnpm typecheck && pnpm test && pnpm toy:typecheck && pnpm toy:go:test && pnpm toy:cli:test && pnpm build && pnpm toy:build",
    "integration:live": "node --import tsx src/integration/liveProfile.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "codex:generate": "codex app-server generate-ts --out src/codex/generated && codex app-server generate-json-schema --out schema/codex-app-server"
  },
  "keywords": [
    "codex",
    "linear",
    "orchestration",
    "software-factory",
    "takt"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "liquidjs": "^10.21.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
